# Copie para .env (que não é versionado) ou defina como variáveis de ambiente.
# Todas são opcionais: os valores abaixo, exceto o token, são os padrões da aplicação.

# URL base da API da FIPE
FIPE_API_BASE_URL=https://fipe.api.br/api/v2

# Token gratuito em https://fipe.api.br/register (sem token: 500 req/dia; com token: 1.000 req/dia).
# Enviado no header X-Subscription-Token, só pelo servidor. Deixe vazio para usar sem token.
FIPE_API_TOKEN=seu-token-aqui

# Timeouts das chamadas à FIPE (formato Duration do Spring: 500ms, 3s, 1m...)
FIPE_CONNECT_TIMEOUT=3s
FIPE_READ_TIMEOUT=5s

# Novas tentativas em falhas temporárias (timeout, 502, 503, 504) e espera inicial (dobra a cada tentativa)
FIPE_MAX_TENTATIVAS=2
FIPE_ESPERA_INICIAL=300ms

# Cache: marcas/modelos/anos (catálogo) e preços
FIPE_CACHE_CATALOGO_TTL=24h
FIPE_CACHE_PRECO_TTL=6h
FIPE_CACHE_TAMANHO_MAXIMO=10000

# Porta HTTP da aplicação
SERVER_PORT=8080
